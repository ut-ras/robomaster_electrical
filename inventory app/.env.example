# Copy to .env and fill in. Leave a block empty to run that part in demo mode.
# .env stays on the server; nothing here is ever sent to phones.

# --- Team sign-in (required for real use) ---
# Name:PIN pairs, comma separated. Remove someone to revoke their access.
TEAM_MEMBERS=
# Any long random string; keeps people signed in across server restarts.
SESSION_SECRET=

# --- Google Sheet (live storage) ---
# The long id in https://docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=
# Path to the service-account key JSON (keep it outside the repo or in secrets/, which is git-ignored)
GOOGLE_SERVICE_ACCOUNT_FILE=
# ...or the JSON itself / base64 of it (for hosts that only take env vars)
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Mouser Search API ---
MOUSER_API_KEY=

# --- DigiKey Product Information API v4 (production app, client-credentials flow) ---
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

PORT=8787
